{
  "$schema": "https://raw.githubusercontent.com/doc-detective/common/refs/heads/main/dist/schemas/spec_v3.schema.json",
  "description": "Windows Calculator automation example - demonstrates basic arithmetic operations. COMPATIBILITY: Tested on Windows 11 23H2 (Build 22631) with Calculator app version 11.2310.0.0 (Microsoft Store). NOTE: Calculator element IDs and accessible names may vary by Windows version, locale, and Calculator app version. This spec uses elementText (maps to UIA Name property) as primary selectors for better cross-version compatibility. If tests fail, inspect the Calculator UI with Accessibility Insights or UI Spy to find the correct element identifiers for your environment. LOCALIZATION: Current selectors use English (en-US) accessible names. For other locales, update the elementText values to match the localized button labels (e.g., 'Siete' for Spanish '7').",
  "tests": [
    {
      "testId": "calculator-basic-addition",
      "description": "Verify 7 + 3 = 10 using Windows Calculator",
      "contexts": [
        {
          "platforms": "windows",
          "apps": {
            "name": "calculator",
            "options": {
              "smoothMouseMove": true,
              "launchTimeout": 30000
            }
          }
        }
      ],
      "steps": [
        {
          "description": "Click the number 7",
          "click": {
            "elementText": "Seven"
          }
        },
        {
          "description": "Click the plus button",
          "click": {
            "elementText": "Plus"
          }
        },
        {
          "description": "Click the number 3",
          "click": {
            "elementText": "Three"
          }
        },
        {
          "description": "Click the equals button",
          "click": {
            "elementText": "Equals"
          }
        },
        {
          "description": "Verify the result shows 10",
          "find": {
            "elementText": "/Display is 10/"
          }
        },
        {
          "description": "Take a screenshot of the result",
          "screenshot": {
            "path": "calculator-result.png",
            "directory": "screenshots"
          }
        }
      ]
    },
    {
      "testId": "calculator-clear-and-multiply",
      "description": "Clear calculator and verify 8 x 4 = 32",
      "contexts": [
        {
          "platforms": "windows",
          "apps": "calculator"
        }
      ],
      "steps": [
        {
          "description": "Click the clear button",
          "click": {
            "elementText": "Clear"
          }
        },
        {
          "description": "Click the number 8",
          "click": {
            "elementText": "Eight"
          }
        },
        {
          "description": "Click the multiply button",
          "click": {
            "elementText": "Multiply by"
          }
        },
        {
          "description": "Click the number 4",
          "click": {
            "elementText": "Four"
          }
        },
        {
          "description": "Click the equals button",
          "click": {
            "elementText": "Equals"
          }
        },
        {
          "description": "Verify the result shows 32",
          "find": {
            "elementText": "/Display is 32/"
          }
        }
      ]
    }
  ]
}
